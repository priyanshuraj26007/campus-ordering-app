# Copy to .env.local. Never commit or share the secrets. Test keys only for now.

# Supabase -> Connect -> Transaction pooler (port 6543), with your database password filled in.
DATABASE_URL=

# Razorpay dashboard -> Account & Settings -> API keys (test mode). Starts with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google sign-in (OAuth client of type "Web application" in Google Cloud). See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production only. A long random string that signs sign-in cookies.
SESSION_SECRET=
# Production only. The public address, e.g. https://order.example.com, so Google returns people there.
APP_URL=
